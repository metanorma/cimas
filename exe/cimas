#!/usr/bin/env ruby

require_relative '../lib/cimas'

begin
  Cimas::Cli::Runner.start(ARGV)
rescue Cimas::Cli::Error, Thor::Error => e
  # Expected user errors (bad options, refused scope): a clean message,
  # no backtrace.
  warn "Error: #{e.message}"
  exit 1
rescue => e
  warn "Error: #{e.message}"
  warn e.backtrace
  exit 1
end
